        "@print-engine/expr": "workspace:*",
        "@print-engine/schema": "workspace:*",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.0.0",
        "jsdom": "^29.1.1",
        "vite": "^7.0.0"
    }
}